{"id":"a06b_star","src":"# A five-point star, then a dashed line under it.\nimport turtle\n\nturtle.color(\"red\")\nfor point in range(5):\n    turtle.forward(120)\n    turtle.right(144)\nturtle.penup()\nturtle.right(90)\nturtle.forward(95)\nturtle.left(90)\nfor dash in range(6):\n    turtle.pendown()\n    turtle.forward(10)\n    turtle.penup()\n    turtle.forward(10)\nturtle.done()\n","python":"3.13.16","out":"","states":[[0.0,0.0,0.0,true,"black"],[0.0,0.0,0.0,true,"red"],[120.0,0.0,0.0,true,"red"],[120.0,0.0,216.0,true,"red"],[22.92,-70.53,216.0,true,"red"],[22.92,-70.53,72.0,true,"red"],[60.0,43.59,72.0,true,"red"],[60.0,43.59,288.0,true,"red"],[97.08,-70.53,288.0,true,"red"],[97.08,-70.53,144.0,true,"red"],[0.0,0.0,144.0,true,"red"],[0.0,0.0,0.0,true,"red"],[0.0,0.0,0.0,false,"red"],[0.0,0.0,270.0,false,"red"],[0.0,-95.0,270.0,false,"red"],[0.0,-95.0,0.0,false,"red"],[0.0,-95.0,0.0,true,"red"],[10.0,-95.0,0.0,true,"red"],[10.0,-95.0,0.0,false,"red"],[20.0,-95.0,0.0,false,"red"],[20.0,-95.0,0.0,true,"red"],[30.0,-95.0,0.0,true,"red"],[30.0,-95.0,0.0,false,"red"],[40.0,-95.0,0.0,false,"red"],[40.0,-95.0,0.0,true,"red"],[50.0,-95.0,0.0,true,"red"],[50.0,-95.0,0.0,false,"red"],[60.0,-95.0,0.0,false,"red"],[60.0,-95.0,0.0,true,"red"],[70.0,-95.0,0.0,true,"red"],[70.0,-95.0,0.0,false,"red"],[80.0,-95.0,0.0,false,"red"],[80.0,-95.0,0.0,true,"red"],[90.0,-95.0,0.0,true,"red"],[90.0,-95.0,0.0,false,"red"],[100.0,-95.0,0.0,false,"red"],[100.0,-95.0,0.0,true,"red"],[110.0,-95.0,0.0,true,"red"],[110.0,-95.0,0.0,false,"red"],[120.0,-95.0,0.0,false,"red"]]}
