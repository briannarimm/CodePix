e",["float","0.5"]],["w_rattle",["float","2.0"]],["tickets",["list",null,"1"]],["name",["str","'radio'"]],["age",["int","9"]],["rattles",["int","1"]],["z",["float","3.5"]],["p",["float","0.9706877692486436"]],["answer",["str","'yes'"]]]}],"rv":["NoneType","None"]}],"out":"toaster z = -2.0 p = 0.12 new part? no\nkettle z = 1.0 p = 0.73 new part? yes\nradio z = 3.5 p = 0.97 new part? yes\n","err":"","truncated":false,"id":"b06_score","python":"3.13.16","src":"# Does a gadget need a new part? A hand-made yes-or-no machine.\n# The weights and the bias are our own guesses. Nothing is learned yet.\nimport math\n\nbias = -3.0\nw_age = 0.5      # for each year of age\nw_rattle = 2.0   # rattles is 1 if it rattles, 0 if it does not\n\ntickets = [(\"toaster\", 2, 0), (\"kettle\", 4, 1), (\"radio\", 9, 1)]\n\nfor name, age, rattles in tickets:\n    z = bias + w_age * age + w_rattle * rattles\n    p = 1 / (1 + math.exp(-z))\n    answer = \"yes\" if p >= 0.5 else \"no\"\n    print(name, \"z =\", z, \"p =\", round(p, 2), \"new part?\", answer)\n"}