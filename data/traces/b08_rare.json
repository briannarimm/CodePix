l",["float","0.0"]]]}]},{"l":9,"ev":"return","o":32,"st":[{"fn":"<module>","l":13,"v":[["lazy_scores",["function","<function lazy_scores>"]]]},{"fn":"lazy_scores","l":9,"v":[["positives",["int","100"]],["total",["int","1000000"]],["tp",["int","0"]],["fn",["int","100"]],["tn",["int","999900"]],["fp",["int","0"]],["accuracy",["float","0.9999"]],["recall",["float","0.0"]]]}],"rv":["tuple",null,"2"],"h":{"2":{"t":"tuple","n":2,"items":[["float","0.9999"],["float","0.0"]]}}},{"l":13,"ev":"return","o":66,"st":[{"fn":"<module>","l":13,"v":[["lazy_scores",["function","<function lazy_scores>"]]]}],"rv":["NoneType","None"]}],"out":"1% positives:       (0.99, 0.0)\n100 in a million:   (0.9999, 0.0)\n","err":"","truncated":false,"id":"b08_rare","python":"3.13.16","src":"# A lazy machine that always answers \"no\". How good does accuracy say it is?\n\n\ndef lazy_scores(positives, total):\n    tp, fn = 0, positives          # it never says yes, so it misses every positive\n    tn, fp = total - positives, 0\n    accuracy = (tp + tn) / total\n    recall = tp / (tp + fn)\n    return accuracy, recall\n\n\nprint(\"1% positives:      \", lazy_scores(10, 1000))\nprint(\"100 in a million:  \", lazy_scores(100, 1_000_000))\n"}