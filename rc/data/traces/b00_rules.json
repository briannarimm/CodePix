rules for sorting repair tickets (fictional).\ntickets = [\n    (\"fridge\", \"humming\", \"big\"),\n    (\"toaster\", \"grinding\", \"big\"),\n    (\"kettle\", \"quiet\", \"quick\"),\n    (\"fan\", \"grinding\", \"quick\"),\n    (\"lamp\", \"quiet\", \"big\"),\n]\n\n\ndef rule(appliance, sound):\n    if appliance == \"fridge\":\n        return \"big\"\n    if sound == \"grinding\":\n        return \"big\"\n    return \"quick\"\n\n\nright = 0\nfor appliance, sound, actual in tickets:\n    guess = rule(appliance, sound)\n    if guess == actual:\n        right = right + 1\n    else:\n        print(\"rule broke on:\", appliance, sound)\nprint(right, \"of\", len(tickets), \"right\")\n"}