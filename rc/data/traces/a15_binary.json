"]],["part_numbers",["list",null,"1"]]]}],"rv":["NoneType","None"]}],"out":"(9, 4)\n(-1, 4)\n","err":"","truncated":false,"id":"a15_binary","python":"3.13.16","src":"# Look in the middle of a sorted shelf, then set half aside.\ndef binary_search(numbers, target):\n    low = 0\n    high = len(numbers) - 1\n    looks = 0\n    while low <= high:\n        mid = (low + high) // 2\n        looks = looks + 1\n        if numbers[mid] == target:\n            return mid, looks\n        if numbers[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return -1, looks\n\n\npart_numbers = [104, 117, 230, 245, 312, 388, 401, 470, 512, 640, 777, 901]\nprint(binary_search(part_numbers, 640))\nprint(binary_search(part_numbers, 300))\n"}