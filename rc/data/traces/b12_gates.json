,{"l":8,"ev":"line","o":75,"st":[{"fn":"<module>","l":8,"v":[["unit",["function","<function unit>"]],["x1",["int","1"]],["x2",["int","1"]],["both",["int","1"]],["either",["int","1"]]]}]},{"l":8,"ev":"return","o":75,"st":[{"fn":"<module>","l":8,"v":[["unit",["function","<function unit>"]],["x1",["int","1"]],["x2",["int","1"]],["both",["int","1"]],["either",["int","1"]]]}],"rv":["NoneType","None"]}],"out":"x1 x2 | AND OR\n0   0 | 0    0\n0   1 | 0    1\n1   0 | 0    1\n1   1 | 1    1\n","err":"","truncated":false,"id":"b12_gates","python":"3.13.16","src":"# One unit with a step: it answers 1 when z is above 0, and 0 otherwise.\ndef unit(w1, w2, b, x1, x2):\n    z = w1 * x1 + w2 * x2 + b\n    return 1 if z > 0 else 0\n\n\nprint(\"x1 x2 | AND OR\")\nfor x1 in (0, 1):\n    for x2 in (0, 1):\n        both = unit(1, 1, -1.5, x1, x2)\n        either = unit(1, 1, -0.5, x1, x2)\n        print(x1, \" \", x2, \"|\", both, \"  \", either)\n"}