: (150, 15)}\n\nprecisions = []\nall_tp = all_fp = 0\nfor kind, (tp, fp) in kinds.items():\n    p = tp / (tp + fp)\n    precisions.append(p)\n    all_tp += tp\n    all_fp += fp\n    print(kind, \"precision\", round(p, 2))\n\nmacro = sum(precisions) / len(precisions)\nmicro = all_tp / (all_tp + all_fp)\nprint(\"macro average\", round(macro, 2))\nprint(\"micro average\", round(micro, 2))\n"}