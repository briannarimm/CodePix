<module>","l":15,"v":[["examples",["list",null,"1"]],["counts",["dict",null,"7"]],["sound",["str","'humming'"]],["size",["str","'big'"]],["tally",["dict",null,"10"]],["best",["str","'big'"]]]}]},{"l":15,"ev":"return","o":115,"st":[{"fn":"<module>","l":15,"v":[["examples",["list",null,"1"]],["counts",["dict",null,"7"]],["sound",["str","'humming'"]],["size",["str","'big'"]],["tally",["dict",null,"10"]],["best",["str","'big'"]]]}],"rv":["NoneType","None"]}],"out":"grinding {'big': 2, 'quick': 1} -> big\nquiet {'big': 0, 'quick': 2} -> quick\nhumming {'big': 2, 'quick': 1} -> big\n","err":"","truncated":false,"id":"b00_examples","python":"3.13.16","src":"# Learn a sorting rule from examples instead of writing it by hand.\n# Each example: the sound a gadget made, and how big the job turned out (fictional).\nexamples = [\n    (\"grinding\", \"big\"), (\"grinding\", \"big\"), (\"grinding\", \"quick\"),\n    (\"quiet\", \"quick\"), (\"quiet\", \"quick\"),\n    (\"humming\", \"big\"), (\"humming\", \"quick\"), (\"humming\", \"big\"),\n]\n\ncounts = {}\nfor sound, size in examples:\n    if sound not in counts:\n        counts[sound] = {\"big\": 0, \"quick\": 0}\n    counts[sound][size] = counts[sound][size] + 1\n\nfor sound in counts:\n    tally = counts[sound]\n    best = max(tally, key=tally.get)\n    print(sound, tally, \"->\", best)\n"}