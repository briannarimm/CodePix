  position = index\n    while position > 0:\n        comparisons = comparisons + 1\n        if prices[position - 1] <= current:\n            break\n        prices[position] = prices[position - 1]  # shift the bigger price right\n        position = position - 1\n    prices[position] = current\nprint(prices, \"comparisons:\", comparisons)\n"}